/**
 * @name Call of the Night
 * @author HeyImPickle
 * @description A dark vampiric Discord theme inspired by Call of the Night with animated background
 * @version 1.0.0
 * @updateUrl https://raw.githubusercontent.com/HeyImPickle/DiscordTheme4Me/main/CallOfTheNight.theme.css
 * @source https://github.com/HeyImPickle/DiscordTheme4Me
 * @website https://github.com/HeyImPickle/DiscordTheme4Me
 */

:root {
  /* Primary Colors - Vampiric Theme */
  --blood-red: #8b0000;
  --crimson: #dc143c;
  --pale-gold: #d4af37;
  --dark-purple: #2a0845;
  --dark-bg: #0f0f0f;
  --darker-bg: #1a1a1a;
  --card-bg: #1f1f1f;
  
  /* Text Colors */
  --text-primary: #e8e8e8;
  --text-secondary: #b8b8b8;
  --text-muted: #808080;
}

/* Main background with GIF */
.appAsidePanelRouter-3p_3W0,
.app-3xd6d0,
body {
  background-image: url('https://media1.tenor.com/m/difVerr8A-MAAAAd/call-of-the-night-yofukashi-no-uta.gif');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-color: var(--dark-bg) !important;
}

/* Overlay for readability */
.appAsidePanelRouter-3p_3W0::before,
.app-3xd6d0::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(15, 15, 15, 0.6) 0%, rgba(15, 15, 15, 0.5) 50%, rgba(15, 15, 15, 0.6) 100%),
              radial-gradient(ellipse at 50% 0%, rgba(139, 0, 0, 0.1) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

/* Chat background */
.chatContent-3KjqkW,
.container-YkUktl {
  background-color: rgba(31, 31, 31, 0.95) !important;
}

/* Sidebar background */
.sidebar-2K8pFh {
  background-color: rgba(26, 26, 26, 0.98) !important;
  border-right: 2px solid var(--blood-red) !important;
}

/* Server list background */
.guilds-2JjMmN {
  background-color: rgba(15, 15, 15, 0.98) !important;
}

/* Header/titlebar */
.header-2V-4Sw,
.headerBar-UHjgbI {
  background: linear-gradient(180deg, rgba(26, 26, 26, 0.98) 0%, rgba(22, 22, 22, 0.98) 100%) !important;
  border-bottom: 2px solid var(--blood-red) !important;
  box-shadow: 0 4px 12px rgba(139, 0, 0, 0.3) !important;
}

/* Message text color */
.messageContent-2qWWxC,
.markup-eYLPri {
  color: var(--text-primary) !important;
}

/* Username/author color */
.username-1A8OIc,
.name-2WpE7M {
  color: var(--pale-gold) !important;
  font-weight: 700 !important;
  text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
}

/* Message hover effect */
.message-G6aipy:hover {
  background-color: rgba(139, 0, 0, 0.08) !important;
}

/* Unread indicator */
.unread-2lAfLh {
  background-color: var(--crimson) !important;
}

/* Input box */
.channelTextArea-1VQBuP textarea,
.textArea-12jD-V {
  background-color: rgba(31, 31, 31, 0.9) !important;
  border: 1px solid rgba(139, 0, 0, 0.3) !important;
  color: var(--text-primary) !important;
  border-radius: 8px !important;
}

.channelTextArea-1VQBuP textarea:focus,
.textArea-12jD-V:focus {
  border-color: var(--crimson) !important;
  background-color: rgba(31, 31, 31, 0.95) !important;
  box-shadow: 0 0 8px rgba(220, 20, 60, 0.2) !important;
}

/* Send button */
.channelTextArea-1VQBuP button[type="submit"],
.button-f9qj4e {
  background: linear-gradient(135deg, var(--blood-red), var(--crimson)) !important;
  color: var(--pale-gold) !important;
  border: none !important;
}

.channelTextArea-1VQBuP button[type="submit"]:hover,
.button-f9qj4e:hover {
  background: linear-gradient(135deg, var(--crimson), #ff1744) !important;
  box-shadow: 0 0 16px rgba(220, 20, 60, 0.5) !important;
}

/* Reaction styling */
.reaction-3vvnSF,
.reactionDefault-bW90Ld {
  background-color: rgba(139, 0, 0, 0.15) !important;
  border: 1px solid rgba(220, 20, 60, 0.3) !important;
}

.reaction-3vvnSF:hover,
.reactionDefault-bW90Ld:hover {
  background-color: rgba(139, 0, 0, 0.3) !important;
  border-color: var(--crimson) !important;
}

/* Member list */
.members-1998pB {
  background-color: rgba(26, 26, 26, 0.98) !important;
  border-left: 2px solid var(--blood-red) !important;
}

/* Member hover */
.member-3W1lQa:hover {
  background-color: rgba(139, 0, 0, 0.1) !important;
}

/* Role colors */
.roleName-qXpaP {
  color: var(--pale-gold) !important;
}

/* Scrollbar styling */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: rgba(139, 0, 0, 0.05);
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, var(--blood-red), var(--crimson));
  border-radius: 4px;
  opacity: 0.6;
}

::-webkit-scrollbar-thumb:hover {
  opacity: 1;
}

/* Embed styling */
.embed-IeVOXJ {
  background-color: rgba(139, 0, 0, 0.1) !important;
  border-left: 4px solid var(--crimson) !important;
}

.embedTitle-NM0GLJ,
.embedAuthorName-3B4Y2e {
  color: var(--pale-gold) !important;
}

/* Code blocks */
.hljs,
.code-2HZ5uS {
  background-color: rgba(15, 15, 15, 0.8) !important;
  color: var(--text-primary) !important;
  border: 1px solid rgba(139, 0, 0, 0.2) !important;
}

/* Status indicators */
.wrapper-3HNnKV[aria-label*="Online"] {
  background-color: #a41e34 !important;
}

.wrapper-3HNnKV[aria-label*="Away"] {
  background-color: #ff6b35 !important;
}

.wrapper-3HNnKV[aria-label*="Do Not Disturb"] {
  background-color: #d32f2f !important;
}

.wrapper-3HNnKV[aria-label*="Offline"] {
  background-color: #808080 !important;
}

/* User avatar styling */
.avatar-VxgULZ {
  border: 2px solid var(--crimson) !important;
  box-shadow: 0 0 8px rgba(220, 20, 60, 0.4) !important;
}

/* Hovering over users */
.userPopout-3XzG_A {
  background-color: rgba(26, 26, 26, 0.98) !important;
  border: 2px solid var(--blood-red) !important;
  box-shadow: 0 8px 24px rgba(139, 0, 0, 0.3) !important;
}

/* Server boosts */
.premiumGuildSubscribeButton-2Ze-tA {
  background: linear-gradient(135deg, var(--blood-red), var(--crimson)) !important;
}

/* Notification badge */
.numberBadge-2s8kKA {
  background-color: var(--crimson) !important;
  color: var(--pale-gold) !important;
  font-weight: 700 !important;
}

/* Channel text */
.name-uJV0GL,
.channelName-1QajIW {
  color: var(--text-secondary) !important;
}

.name-uJV0GL:hover,
.channelName-1QajIW:hover {
  color: var(--pale-gold) !important;
}

/* Selected channel */
.selected-aXhQR {
  background-color: rgba(139, 0, 0, 0.2) !important;
  border-left: 3px solid var(--crimson) !important;
  color: var(--pale-gold) !important;
}

/* Category text */
.categoryHeader-O-mvqn {
  color: var(--text-muted) !important;
  text-transform: uppercase !important;
  letter-spacing: 1px !important;
  font-weight: 600 !important;
}

/* Friends list */
.peopleListItem-2nzedh:hover {
  background-color: rgba(139, 0, 0, 0.1) !important;
}

/* Direct message */
.privateChannelsHeaderContainer-1UWASf {
  border-top: 2px solid var(--blood-red) !important;
}

/* Voice channels */
.voiceEmpty-1hKoJu {
  color: var(--text-muted) !important;
}

/* Animations */
@keyframes vampireGlow {
  0%, 100% {
    box-shadow: 0 0 8px rgba(220, 20, 60, 0.3);
  }
  50% {
    box-shadow: 0 0 16px rgba(220, 20, 60, 0.6);
  }
}

.message-G6aipy.mentioned-Tre-dv {
  animation: vampireGlow 0.6s ease-in-out;
  border-left: 3px solid var(--crimson);
  background-color: rgba(139, 0, 0, 0.1) !important;
}

/* Timestamp styling */
.timestamp-3ZCmNB {
  color: var(--text-muted) !important;
  font-size: 11px !important;
  letter-spacing: 0.5px !important;
}

/* Search results */
.queryContainer-1A4SY3 {
  background-color: rgba(31, 31, 31, 0.95) !important;
  border-bottom: 2px solid var(--blood-red) !important;
}

/* User settings */
.sidebarRegionScroller-3MXFaO {
  background-color: rgba(26, 26, 26, 0.98) !important;
}

.option-n0icdtw:hover {
  background-color: rgba(139, 0, 0, 0.1) !important;
  color: var(--pale-gold) !important;
}

/* Context menu */
.menu-2QE4yM,
.popout-VEM5aa {
  background-color: rgba(26, 26, 26, 0.98) !important;
  border: 1px solid var(--blood-red) !important;
  box-shadow: 0 8px 24px rgba(139, 0, 0, 0.3) !important;
}

.item-2hkk8n:hover {
  background-color: rgba(139, 0, 0, 0.2) !important;
  color: var(--pale-gold) !important;
}

/* Modal background */
.modal-yWgWj-,
.root-1gCeng {
  background-color: rgba(26, 26, 26, 0.98) !important;
  border: 2px solid var(--blood-red) !important;
}

/* Button styling */
.button-1MtQvP {
  background: linear-gradient(135deg, var(--blood-red), var(--crimson)) !important;
  color: var(--pale-gold) !important;
}

.button-1MtQvP:hover {
  background: linear-gradient(135deg, var(--crimson), #ff1744) !important;
}

/* Secondary button */
.button-1MtQvP.secondary-tnPxZX {
  background-color: rgba(139, 0, 0, 0.2) !important;
  border: 1px solid var(--crimson) !important;
  color: var(--pale-gold) !important;
}

/* Status picker */
.option-2KkLMF:hover {
  background-color: rgba(139, 0, 0, 0.1) !important;
}
